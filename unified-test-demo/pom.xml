<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.vaadin.addons</groupId>
        <artifactId>unified-test-parent</artifactId>
        <version>0.1.0-alpha2</version>
    </parent>
    <artifactId>unified-test-demo</artifactId>
    <name>Unified API: demo application and tests</name>
    <description>
        A small Spring Boot + Vaadin app with Unified UI Tests.
        mvn test                                   runs them on Browserless (default)
        mvn test -Dvaadin.testing.tool=playwright  runs the same tests in Chromium via Dramafinder
    </description>

    <properties>
        <!-- not published -->
        <maven.deploy.skip>true</maven.deploy.skip>
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <gpg.skip>true</gpg.skip>
        <!-- Playwright adapter setting; empty = Playwright's own browser download -->
        <vaadin.testing.playwright.executable />
    </properties>

    <dependencies>
        <!-- runs a failing test from a test, to check its failure evidence -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- the add-on's wrappers ship in the main jar (ADR 0003): compile-time only, never needed at runtime -->
        <dependency>
            <groupId>org.vaadin.addons</groupId>
            <artifactId>unified-test-api</artifactId>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>org.vaadin.addons</groupId>
            <artifactId>unified-test-spring</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.vaadin.addons</groupId>
            <artifactId>unified-test-browserless</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>browserless-test-spring</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.vaadin.addons</groupId>
            <artifactId>unified-test-playwright</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.vaadin.addons</groupId>
            <artifactId>unified-test-selenium</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- JUnit 4, only to compile JUnit4TestBenchTest, the golden JUnit 4 migration input; without the vintage
             engine no JUnit 4 test runs -->
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>4.13.2</version>
            <scope>test</scope>
        </dependency>
        <!-- TestBench's JUnit 6 support (@BrowserTest), for the native TestBench test in docs/comparison.md -->
        <dependency>
            <groupId>com.vaadin</groupId>
            <artifactId>vaadin-testbench-core-junit6</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- @Transactional, to check that a transactional test fails on browser Testing Tools -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-tx</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <!-- failing on purpose; run by other tests through the JUnit launcher -->
                    <excludedGroups>launched-only</excludedGroups>
                    <systemPropertyVariables>
                        <vaadin.testing.playwright.executable>${vaadin.testing.playwright.executable}</vaadin.testing.playwright.executable>
                        <!-- TestBench's own setting, for the native TestBench test (@BrowserTest) -->
                        <com.vaadin.testbench.Parameters.headless>true</com.vaadin.testbench.Parameters.headless>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
