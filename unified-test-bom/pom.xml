<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Standalone BOM (no parent), so importing it pulls in nothing else. -->
    <groupId>org.vaadin.addons</groupId>
    <artifactId>unified-test-bom</artifactId>
    <version>0.1.0-alpha2</version>
    <packaging>pom</packaging>
    <name>Unified API BOM</name>
    <description>Versions of the Unified API artifacts and of the Testing Tools they run on.</description>
    <url>https://github.com/parttio/unified-testing-tool</url>

    <!-- Maven Central needs this metadata on every published POM; the BOM has no parent to inherit it from. -->
    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0</url>
        </license>
    </licenses>
    <developers>
        <developer>
            <name>JC Gueriaud</name>
        </developer>
    </developers>
    <scm>
        <url>https://github.com/parttio/unified-testing-tool</url>
        <connection>scm:git:https://github.com/parttio/unified-testing-tool.git</connection>
        <developerConnection>scm:git:ssh://git@github.com/parttio/unified-testing-tool.git</developerConnection>
        <tag>unified-test-0.1.0-alpha2</tag>
    </scm>

    <properties>
        <browserless-test.version>25.3.2</browserless-test.version>
        <dramafinder.version>2.0.2</dramafinder.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.vaadin.addons</groupId>
                <artifactId>unified-test-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vaadin.addons</groupId>
                <artifactId>unified-test-browserless</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vaadin.addons</groupId>
                <artifactId>unified-test-playwright</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vaadin.addons</groupId>
                <artifactId>unified-test-selenium</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vaadin.addons</groupId>
                <artifactId>unified-test-spring</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>browserless-test-junit6</artifactId>
                <version>${browserless-test.version}</version>
            </dependency>
            <dependency>
                <groupId>com.vaadin</groupId>
                <artifactId>browserless-test-spring</artifactId>
                <version>${browserless-test.version}</version>
            </dependency>
            <dependency>
                <groupId>org.vaadin.addons</groupId>
                <artifactId>dramafinder</artifactId>
                <version>${dramafinder.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <profiles>
        <!-- Same publishing as the parent's release profile (sources and javadoc don't apply to a BOM). -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>0.12.0</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>3.2.7</version>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                        <configuration>
                            <signer>bc</signer>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
